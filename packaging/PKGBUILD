# Maintainer: berkkucukk <berkkucukk@proton.me>
#
# LOCAL-BUILD PKGBUILD — see ../build-pkg.sh, which writes `pkgver` and drops
# `maze-vault-$pkgver.tar.gz` next to this file before invoking makepkg.

pkgname=maze-vault
pkgver=0.1.0
pkgrel=2
pkgdesc="Maze Vault — a Bitwarden/Vaultwarden-compatible password manager (client only, no telemetry)"
arch=('any')
url="https://mazelinux.berkkucukk.com.tr"
license=('GPL3')

# A client only: it talks to the user's own Vaultwarden / Bitwarden server, or
# keeps a local vault. No server, no service, no privileges.
depends=(
    'maze-python'   # shared Python runtime: PyQt6 + python-cryptography (Argon2id, AES, RSA)
)
# Tests only — never installed for users. check() starts a throwaway
# Vaultwarden on 127.0.0.1; it never contacts a real server.
checkdepends=('vaultwarden')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

check() {
    cd "$srcdir/maze-vault-${pkgver}"
    QT_QPA_PLATFORM=offscreen /opt/maze/venv/bin/python3 -m unittest discover -s tests -p 'test_*.py'
}

package() {
    cd "$srcdir/maze-vault-${pkgver}"

    install -dm755 "$pkgdir/opt/maze-vault"
    cp -r mazevault main.py "$pkgdir/opt/maze-vault/"
    install -m644 MAZE-VAULT.png maze-vault-logo.svg "$pkgdir/opt/maze-vault/"

    install -dm755 "$pkgdir/usr/bin"
    install -m755 /dev/stdin "$pkgdir/usr/bin/maze-vault" << 'LAUNCHER'
#!/usr/bin/env bash
exec /opt/maze/venv/bin/python3 /opt/maze-vault/main.py "$@"
LAUNCHER

    install -dm755 "$pkgdir/usr/share/applications"
    install -m644 /dev/stdin "$pkgdir/usr/share/applications/maze-vault.desktop" << 'DESKTOP'
[Desktop Entry]
Version=1.0
Type=Application
Name=Maze Vault
GenericName=Password Manager
GenericName[tr]=Şifre Yöneticisi
Comment=Bitwarden-compatible password manager — your own server or this computer only
Comment[tr]=Bitwarden uyumlu şifre yöneticisi — kendi sunucun ya da sadece bu bilgisayar
Exec=/usr/bin/maze-vault
Icon=maze-vault
Terminal=false
Categories=Utility;Security;
Keywords=password;passwords;bitwarden;vaultwarden;vault;totp;2fa;şifre;parola;kasa;
StartupNotify=true
StartupWMClass=maze-vault
DESKTOP

    install -Dm644 maze-vault-logo.svg "$pkgdir/usr/share/icons/hicolor/scalable/apps/maze-vault.svg"
    for size in 16 22 24 32 48 64 128 256 512; do
        install -dm755 "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps"
        magick MAZE-VAULT.png -resize "${size}x${size}" \
            "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/maze-vault.png" \
            2>/dev/null || install -m644 MAZE-VAULT.png \
            "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/maze-vault.png"
    done

    install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
